NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
CORS_ORIGIN=*

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/remarket
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/remarket_test

# JWT Configuration
JWT_SECRET=change-this-to-a-strong-32-character-jwt-secret
JWT_ACCESS_SECRET=change-this-to-a-strong-32-character-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-strong-32-char-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Upload & AI Service Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
AI_SERVICE_URL=http://127.0.0.1:8000

# Rate Limiting
BCRYPT_SALT_ROUNDS=10
THROTTLE_TTL=60
THROTTLE_LIMIT=100
