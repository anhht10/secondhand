# ============================================================
# ReMarket AI Service (.env.example)
# ============================================================

# Google Gemini LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=2

# Google Gemini Embedding Configuration (RAG)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_BATCH_SIZE=32

# NestJS Backend Integration Configuration
BACKEND_API_BASE_URL=http://localhost:5000/api/v1
BACKEND_SERVICE_TOKEN=
BACKEND_TIMEOUT_SECONDS=10.0
BACKEND_MAX_RETRIES=2
BACKEND_POOL_MAX_CONNECTIONS=20
BACKEND_POOL_MAX_KEEPALIVE=10

# AI Service Runtime Configuration
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO

# LangGraph Checkpointer, Memory & Rate Limiting Configuration
CHECKPOINTER_DATABASE_URL=memory://
CONVERSATION_MAX_HISTORY_MESSAGES=20
AI_RATE_LIMIT_REQUESTS=60
AI_RATE_LIMIT_WINDOW_SECONDS=60

# Optional LangSmith Tracing / Observability
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=remarket-ai-service

# RAG Vector Store Configuration
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=remarket_knowledge_base
RAG_KNOWLEDGE_BASE_DIR=./data/knowledge_base
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_DEFAULT_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.35
