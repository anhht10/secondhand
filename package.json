{
  "name": "remarket-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ReMarket Second-Hand Marketplace Monorepo (NestJS Backend + Python LangGraph AI + Flutter FE)",
  "scripts": {
    "start": "python main.py",
